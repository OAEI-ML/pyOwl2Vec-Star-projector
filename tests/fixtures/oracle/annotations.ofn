 AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> :A "namespace")
 AnnotationAssertion(rdfs:label :A "42"^^xsd:integer)
 AnnotationAssertion(rdfs:label :A "true"^^xsd:boolean)
 AnnotationAssertion(rdfs:label :A "2026-07-16"^^xsd:date)
 AnnotationAssertion(rdfs:label :A <urn:oracle:value>)
 AnnotationAssertion(rdfs:label :A "")
 AnnotationAssertion(:unsupported :A "ignored")
