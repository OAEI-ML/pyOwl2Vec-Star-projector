Prefix(:=<urn:oracle:annotations#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(skos:=<http://www.w3.org/2004/02/skos/core#>)
Ontology(<urn:oracle:annotations>
 Declaration(Class(:A))
 Declaration(AnnotationProperty(:unsupported))
 AnnotationAssertion(rdfs:label :A "plain string")
