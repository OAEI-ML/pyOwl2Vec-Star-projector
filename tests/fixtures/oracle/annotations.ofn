 AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDefinition> :A "definition")
 AnnotationAssertion(<http://bioontology.org/projects/ontologies/birnlex#preferred_label> :A "birn label")
 AnnotationAssertion(<http://bioontology.org/projects/ontologies/birnlex#synonyms> :A "birn synonyms")
 AnnotationAssertion(<https://cfpub.epa.gov/ecotox#latinName> :A "Latinus")
 AnnotationAssertion(<https://cfpub.epa.gov/ecotox#commonName> :A "common")
 AnnotationAssertion(<https://www.ncbi.nlm.nih.gov/taxonomy#scientific_name> :A "scientific")
