 AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> :A "alternative label")
 AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> :A "xref")
 AnnotationAssertion(<http://purl.org/dc/elements/1.1/description> :A "dc description")
 AnnotationAssertion(<http://purl.org/dc/terms/description> :A "dct description")
 AnnotationAssertion(<http://purl.org/dc/elements/1.1/title> :A "dc title")
 AnnotationAssertion(<http://purl.org/dc/terms/title> :A "dct title")
