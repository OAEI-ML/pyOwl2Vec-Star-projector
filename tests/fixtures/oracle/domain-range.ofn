Prefix(:=<urn:oracle:domain-range#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<urn:oracle:domain-range>
 Declaration(Class(:D1)) Declaration(Class(:D2)) Declaration(Class(:R1)) Declaration(Class(:R2))
 Declaration(ObjectProperty(:p)) Declaration(ObjectProperty(:child)) Declaration(ObjectProperty(:inverse))
 SubObjectPropertyOf(:child :p)
 InverseObjectProperties(:p :inverse)
 ObjectPropertyDomain(:p :D1)
 ObjectPropertyDomain(Annotation(rdfs:comment "annotated duplicate domain") :p :D1)
 ObjectPropertyDomain(:p :D2)
 ObjectPropertyRange(:p :R1)
 ObjectPropertyRange(Annotation(rdfs:comment "annotated duplicate range") :p :R1)
 ObjectPropertyRange(:p :R2)
 ObjectPropertyDomain(:child ObjectIntersectionOf(:D1 :D2))
 ObjectPropertyRange(:child ObjectUnionOf(:R1 :R2))
)
