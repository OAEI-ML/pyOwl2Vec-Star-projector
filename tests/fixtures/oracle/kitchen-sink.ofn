Prefix(:=<urn:oracle:kitchen#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<urn:oracle:kitchen>
 Declaration(Class(:A)) Declaration(Class(:B)) Declaration(Class(:C))
 Declaration(ObjectProperty(:p)) Declaration(ObjectProperty(:q)) Declaration(ObjectProperty(:inv))
 Declaration(NamedIndividual(:i)) Declaration(NamedIndividual(:j))
 SubObjectPropertyOf(:q :p)
 InverseObjectProperties(:p :inv)
 SubClassOf(:A :B)
 SubClassOf(:A ObjectSomeValuesFrom(:p :C))
 EquivalentClasses(:B ObjectIntersectionOf(:A :C))
 ObjectPropertyDomain(:p :A)
 ObjectPropertyRange(:p :C)
 ClassAssertion(:A :i)
 ObjectPropertyAssertion(:p :i :j)
 AnnotationAssertion(rdfs:label :A "Kitchen label")
)
