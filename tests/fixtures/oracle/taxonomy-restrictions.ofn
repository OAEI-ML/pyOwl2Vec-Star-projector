Prefix(:=<urn:oracle:taxonomy#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<urn:oracle:taxonomy>
 Declaration(Class(:A)) Declaration(Class(:B)) Declaration(Class(:C)) Declaration(Class(:D))
 Declaration(ObjectProperty(:p)) Declaration(ObjectProperty(:q))
 SubClassOf(:A :B)
 SubClassOf(:A ObjectSomeValuesFrom(:p :C))
 SubClassOf(ObjectSomeValuesFrom(:q :D) :B)
 SubClassOf(:A ObjectAllValuesFrom(:p :D))
 SubClassOf(ObjectAllValuesFrom(:q :C) :B)
 SubClassOf(:A ObjectMinCardinality(2 :p :C))
 SubClassOf(ObjectMinCardinality(1 :q :D) :B)
 SubClassOf(:A ObjectMaxCardinality(3 :p :D))
 SubClassOf(ObjectMaxCardinality(4 :q :C) :B)
 SubClassOf(:A ObjectMinCardinality(1 :q))
 SubClassOf(:A ObjectMaxCardinality(2 :q))
 SubClassOf(:A ObjectExactCardinality(1 :p :C))
 SubClassOf(:A ObjectSomeValuesFrom(:p ObjectIntersectionOf(:C :D)))
 SubClassOf(ObjectUnionOf(:A :B) :C)
)
